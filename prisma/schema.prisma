generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String       @id @default(cuid())
  email                   String       @unique
  password                String
  name                    String
  phone                   String?
  photo                   String?
  accountType             AccountType  @default(PATIENT)
  emailVerified           Boolean      @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  bookings                Booking[]    @relation("PatientBookings")
  doctor                  Doctor?
  permissions             Permission[]

  @@map("users")
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  resource  Resource
  action    Action
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@map("permissions")
}

model Doctor {
  id              String         @id @default(cuid())
  userId          String         @unique
  bio             String?
  slug            String         @unique
  specializations String[]
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  availability    Availability[]
  blockedSlots    BlockedSlot[]
  bookings        Booking[]      @relation("DoctorBookings")
  doctorNotes     DoctorNote[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctors")
}

model Availability {
  id              String   @id @default(cuid())
  doctorId        String
  dayOfWeek       Int
  startTime       String
  endTime         String
  sessionDuration Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("availability")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  doctorId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("blocked_slots")
}

model AdminSchedule {
  id              String   @id @default(cuid())
  dayOfWeek       Int      @unique
  startTime       String
  endTime         String
  sessionDuration Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("admin_schedules")
}

model GlobalBlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@map("global_blocked_dates")
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  doctorId    String?
  date        DateTime      @db.Date
  startTime   String
  endTime     String
  service     String
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessionType SessionType   @default(ONLINE)
  doctor      Doctor?       @relation("DoctorBookings", fields: [doctorId], references: [id])
  user        User          @relation("PatientBookings", fields: [userId], references: [id], onDelete: Cascade)
  doctorNotes DoctorNote[]
  payment     Payment?
  sessionRoom SessionRoom?

  @@map("bookings")
}

model DoctorNote {
  id        String   @id @default(cuid())
  content   String
  bookingId String
  doctorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([bookingId, doctorId])
  @@map("doctor_notes")
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("EGP")
  status           PaymentStatus @default(PENDING)
  gatewayReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SessionRoom {
  id        String   @id @default(cuid())
  bookingId String   @unique
  roomName  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("session_rooms")
}

model Settings {
  id                     String   @id @default("singleton")
  platformName           String   @default("Tawasul Academy")
  contactEmail           String   @default("")
  contactPhone           String   @default("")
  whatsappNumber         String   @default("")
  paymentGateway         String   @default("paymob")
  paymentGatewayKey      String   @default("")
  paymentGatewaySecret   String   @default("")
  sessionPricePerHour    Decimal  @default(0) @db.Decimal(10, 2)
  defaultSessionDuration Int      @default(60)
  defaultWorkingStart    String   @default("09:00")
  defaultWorkingEnd      String   @default("17:00")
  updatedAt              DateTime @updatedAt

  @@map("settings")
}

enum AccountType {
  PATIENT
  DOCTOR
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  IN_REVIEW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SessionType {
  ONLINE
  IN_CLINIC
}

enum Resource {
  APPOINTMENTS
  PATIENTS
  DOCTORS
  PAYMENTS
  SETTINGS
  STAFF
}

enum Action {
  CREATE
  READ
  UPDATE
  DELETE
}
