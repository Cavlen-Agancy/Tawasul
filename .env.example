# ─────────────────────────────────────────
# Tawasul Academy — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in all values
# Never commit .env to Git

# APP
# Base URL of the application (runtime; build-time default in nuxt.config)
# Required in production
APP_URL=http://localhost:3000
# Node environment (build-time/runtime)
# Required in production (set to production)
NODE_ENV=development

# DATABASE
# Full PostgreSQL connection string (runtime)
# Required in production (must match POSTGRES user/password below)
DATABASE_URL=postgresql://tawasul:your_db_password@tawasul_postgres:5432/tawasul_db
# PostgreSQL container user (deployment-only, optional, defaults to tawasul)
# Optional
POSTGRES_USER=tawasul
# PostgreSQL container password (deployment-only, required to match DATABASE_URL)
# Required in production
POSTGRES_PASSWORD=your_db_password

# AUTH
# Secret key used to sign JWT tokens (runtime)
# Required in production; minimum 32 chars
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
# JWT token expiry duration (runtime, optional)
# Optional (defaults to 7d)
JWT_EXPIRES_IN=7d

# EMAIL — RESEND
# API key from your Resend account (runtime)
# Required in production if email features used
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender email address (runtime)
# Required in production
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Display name in From field (runtime, optional, defaults to "Tawasul Academy")
# Optional
RESEND_FROM_NAME=Tawasul Academy

# PAYMENT GATEWAY
# Choose one: paymob or stripe (runtime)
# Required in production
PAYMENT_GATEWAY=paymob

# Paymob (runtime)
# Optional unless PAYMENT_GATEWAY=paymob
PAYMOB_API_KEY=your_paymob_api_key
# Optional unless PAYMENT_GATEWAY=paymob
PAYMOB_INTEGRATION_ID=your_paymob_integration_id
# Optional unless PAYMENT_GATEWAY=paymob
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret

# Stripe (runtime)
# Optional unless PAYMENT_GATEWAY=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Optional unless PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Optional unless PAYMENT_GATEWAY=stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx


# VIDEO SESSION — LIVEKIT
# Public URL used by the browser (wss:// in production) (runtime; build-time default)
# Required in production
LIVEKIT_URL=ws://localhost:7880
# Internal URL used by the server SDK (http://tawasul_livekit:7880 in production) (runtime, optional)
# Optional (defaults to http://tawasul_livekit:7880 in production)
LIVEKIT_INTERNAL_URL=http://localhost:7880
# API key (runtime, also used by LiveKit container)
# Required in production
LIVEKIT_API_KEY=
# API secret (runtime, also used by LiveKit container)
# Required in production
LIVEKIT_API_SECRET=

# FILE UPLOADS
# Path where uploaded photos are stored (runtime)
# Required in production (use /app/uploads)
UPLOAD_PATH=./uploads
# Maximum allowed file size in bytes (runtime, optional, defaults 2097152)
# Optional
UPLOAD_MAX_SIZE=2097152

# PGADMIN (development only)
# Optional
PGADMIN_DEFAULT_EMAIL=admin@tawasul.com
# Optional
PGADMIN_DEFAULT_PASSWORD=pgadmin_pass

# SEED
# Initial admin account created by prisma/seed.ts (runtime)
# Required only when seeding
SEED_ADMIN_EMAIL=admin@tawasul.com
# Required only when seeding
SEED_ADMIN_PASSWORD=Change_this_immediately_123
# Required only when seeding
SEED_ADMIN_NAME=Platform Admin

# RUNTIME FLAGS
# Enable session test mode (build-time/runtime public)
# Optional (must be false in production)
NUXT_PUBLIC_ENABLE_SESSION_TEST_MODE=false
# NUXT_PUBLIC_* : runtime overrides for the public runtimeConfig (browser values).
# REQUIRED in production: the image is built without .env, so the build bakes localhost defaults.
# Changing these needs a container restart only, not a rebuild.
NUXT_PUBLIC_APP_URL=https://yourdomain.com
NUXT_PUBLIC_LIVE_KIT_URL=wss://lk.yourdomain.com
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
