# Tawasul Academy — Dockerfile (Development)

FROM node:20-alpine

WORKDIR /app

# Prisma engines on Alpine require OpenSSL (node:alpine images do not ship it)
RUN apk add --no-cache openssl

# Install dependencies first (cached layer)
COPY package*.json ./
RUN npm install

# Copy project files
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
