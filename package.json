    "@fullcalendar/vue3": "^6.1.21",
    "@nuxt/image": "^1.8.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.15.0",
    "@vueuse/nuxt": "^12.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
