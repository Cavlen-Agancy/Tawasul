{
  "name": "tawasul",
  "version": "1.0.0",
  "private": true,
  "description": "Tawasul Academy — Online mental health counseling platform",
  "scripts": {
    "dev": "nuxt dev",
    "dev:db": "docker compose up -d postgres",
    "dev:db:stop": "docker compose stop postgres",
    "build": "nuxt build",
